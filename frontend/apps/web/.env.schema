# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# TeraTones backend URL, e.g. http://localhost:8000. Empty = synthetic demo data.
# @public @optional @type=url
VITE_API_URL=

# Set to 1 to force demo data even when VITE_API_URL is set (offline demos).
# @public @optional @type=enum(0, 1)
VITE_STATIC_MODE=
